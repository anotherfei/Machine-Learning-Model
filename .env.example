PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=your_db
PG_USER=your_user
PG_PASSWORD=your_password

PG_TABLE=your_table_name

# Optional — only set these if the Postgres table's column names differ
# from config.py's raw sensor columns. Each is PG_COL_<name uppercased>
# for whatever config.RAW_SENSOR_COLS / COL_TIMESTAMP currently defines.
# Leave commented out to just use config.py's names.
PG_COL_TIMESTAMP=timestamp
PG_COL_A_RMS_MPS2=a_rms_mps2
PG_COL_V_RMS_MMS=v_rms_mms
PG_COL_A_PEAK_MPS2=a_peak_mps2
PG_COL_CREST_FACTOR=crest_factor
PG_COL_TEMPERATURE_C=temperature_c

# Local full-stack application settings. Change these before production deployment.
APP_SECRET_KEY=replace-with-a-long-random-secret
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
# Used only to create the very first admin when app_users is empty.
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-on-first-deployment
