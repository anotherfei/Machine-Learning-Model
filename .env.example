PG_HOST=<insert>
PG_PORT=<insert>
PG_DATABASE=<insert>
PG_USER=<insert>
PG_PASSWORD=<insert>

PG_TABLE=p1_sel5_vibration

# Multi-machine source mapping. Set PG_COL_MACHINE_ID to the column that
# identifies the unit on each sensor row. If it is left blank/unset, the
# source table is treated as a legacy single-machine table.
PG_COL_MACHINE_ID=mach_id
DEFAULT_MACHINE_ID=B16-MTV-07

# Optional — only set these if the Postgres table's column names differ
# from config.py's raw sensor columns. Each is PG_COL_<name uppercased>
# for whatever config.RAW_SENSOR_COLS / COL_TIMESTAMP currently defines.
# Leave commented out to just use config.py's names.
PG_COL_TIMESTAMP=datetime
PG_COL_A_RMS_MPS2=arms
PG_COL_V_RMS_MMS=vrms
PG_COL_A_PEAK_MPS2=apeak
PG_COL_CREST_FACTOR=crest
PG_COL_TEMPERATURE_C=temp

# Local full-stack application settings. Change these before production deployment.
APP_SECRET_KEY=replace-with-a-long-random-secret
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
# Used only to create the very first admin when app_users is empty.
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=pass